# Copier ce fichier en .env pour le développement local. Détail de chaque variable : DEPLOIEMENT.md

# Obligatoires
DATABASE_URL=postgresql://sereno:sereno@localhost:5432/sereno
APP_URL=http://localhost:3000
# Générer avec : openssl rand -base64 32
AUTH_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres

# E-mails (en local, Mailpit de compose.dev.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sereno <bonjour@sereno.fr>

# Rappels par e-mail (générer avec : openssl rand -hex 24) et adresse du support (facultatif)
CRON_SECRET=
SUPPORT_EMAIL=

# Connexion avec Google et Apple (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
